{
  "name": "newscatcher-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run build && npm --prefix backend run start",
    "dist": "node scripts/build-binaries.mjs"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.3.2",
    "concurrently": "^8.2.2"
  }
}
